"The HUD": {
  "index": 1,
  "category": "basics",
  "sections": [
    {
      "type": "title",
      "value": "The HUD"
    },
    {
      "type": "text",
      "json": [
        {
          "text": "The main hud is the mana bar. In this you will see a "
        },
        {
          "text": "badge with your level",
          "color": "dark_purple"
        },
        {
          "text": " in it, a "
        },
        {
          "text": "main bar representing your mana",
          "color": "dark_purple"
        },
        {
          "text": ", and a"
        },
        {
          "text": " smaller bar below representing your magic XP",
          "color": "dark_purple"
        },
        {
          "text": " to next level. The main bar also has a darker section when holding a spell; this represents the estimated mana cost of the spell, or in the case of a channeled spell, the cost to start channeling it."
        }
      ]
    },
    {
      "type": "title",
      "value": "HUD Display Option"
    },
    {
      "type": "text",
      "json": [
        {
          "text": "Click the hud display tab at the bottom of this UI to change how the HUD displays. You can select always, conditionally (when you have a mana-consuming item equipped), or never. "
        },
        {
          "text": "If you can't see your HUD, you've likely changed this option!",
          "color": "dark_purple"
        }
      ]
    },
    {
      "type": "image",
      "location": "mna:textures/guide/hud_options.png",
      "width": 18,
      "height": 28
    },
    {
      "type": "title",
      "value": "HUD Position Option",
      "newPage": true
    },
    {
      "type": "text",
      "json": [
        {
          "text": "Click the hud position tab at the bottom of this UI to change the HUD position."
        }
      ]
    },
    {
      "type": "image",
      "location": "mna:textures/guide/hud_position.png",
      "width": 18,
      "height": 28
    },
    {
      "type": "text",
      "newPage": true,
      "json": [
        {
          "text": "If you see a "
        },
        {
          "text": "yellow or red warning sign with a lightning bolt",
          "color": "dark_purple"
        },
        {
          "text": " in it next to your mana, this means that you have an item in your inventory that's low on charge or completely empty, respectively."
        }
      ]
    },
    {
      "type": "image",
      "location": "mna:textures/guide/low_charge.png",
      "width": 40,
      "height": 18,
      "newPage": true
    }
  ],
  "related_recipes": []
}