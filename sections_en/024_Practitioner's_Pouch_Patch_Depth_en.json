      "value": "Practitioner's Pouch Patch: Depth"
    },
    {
      "type": "text",
      "json": [
        {
          "text": "When sewn onto a "
        },
        {
          "text": "Practitioner's Pouch",
          "color": "blue"
        },
        {
          "text": ", a "
        },
        {
          "text": "Depth Patch",
          "color": "blue"
        },
        {
          "text": " increases the "
        },
        {
          "text": "stack limit of items",
          "color": "dark_purple"
        },
        {
          "text": " within the Pouch to "
        },
        {
          "text": "four times their normal value",
          "color": "dark_purple"
        },
        {
          "text": ". \n\nAccomplished magicians can create "
        },
        {
          "text": "improved Depth Patches",
          "color": "blue"
        },
        {
          "text": " that can be "
        },
        {
          "text": "sewn on top of the basic Depth Patch",
          "color": "dark_purple"
        },
        {
          "text": ". \n\nStitching an "
        },
        {
          "text": "improved patch",
          "color": "dark_purple"
        },
        {
          "text": " onto a Pouch that already has a Depth Patch increases the stack limits of the items within by four times again for a total of"
        },
        {
          "text": " sixteen times its normal limit",
          "color": "dark_purple"
        },
        {
          "text": "."
        }
      ]
    }
  ],
