    {
      "type": "text",
      "json": [
        {
          "text": "When sewn onto a "
        },
        {
          "text": "Practitioner's Pouch",
          "color": "blue"
        },
        {
          "text": ", a "
        },
        {
          "text": "Speed Patch ",
          "color": "blue"
        },
        {
          "text": "increases the rate at which a ritual bound to the Pouch draws and readies itself by "
