        {
          "text": " icon over the Mote Patch icon, and can be closed by clicking on the red",
          "italic": true
        },
        {
          "text": " -",
          "italic": true,
          "color": "dark_red"
        },
        {
          "text": " icon in the upper right of the patch inventory.",
          "italic": true
        }
      ]
    }
