"Practitioner's Pouch Patch: Weave": {
  "index": -1,
  "category": "rituals",
  "sections": [
    {
      "type": "title",
      "value": "Practitioner's Pouch Patch: Weave"
    },
    {
      "type": "text",
      "json": [
        {
          "text": "When sewn onto a "
        },
        {
          "text": "Practitioner's Pouch",
          "color": "blue"
        },
        {
          "text": ", a "
        },
        {
          "text": "Weave Patch",
          "color": "blue"
        },
        {
          "text": " provides an additional twelve slot inventory that can only hold "
        },
        {
          "text": "Bottled Manaweave Patterns",
          "color": "blue"
        },
        {
          "text": ". \n\nWhen a ritual is started with the pouch, any necessary manaweave patterns stored in the Weave Patch will be consumed automatically. "
        },
        {
          "text": "If all manaweaves are present in bottles, no manaweaving will be necessary to complete the ritual",
          "color": "dark_purple"
        },
        {
          "text": ". If some of the manaweaves are present in bottles in the pouch, only the missing ones will be required to complete the ritual.\n\n"
        },
        {
          "text": "The additional inventory can be accessed by clicking on the green ",
          "italic": true
        },
        {
          "text": "+",
          "italic": true,
          "color": "dark_green"
        },
        {
          "text": " icon over the Weave Patch icon, and can be closed by clicking on the red ",
          "italic": true
        },
        {
          "text": "-",
          "italic": true,
          "color": "dark_red"
        },
        {
          "text": " icon in the upper right of the patch inventory.",
          "italic": true
        }
      ]
    }
  ],
  "related_recipes": [
    {
      "type": "manaweaving_altar",
      "location": "mna:manaweaving/patches/weave"
    }
  ]
}