      "json": [
        {
          "text": "This ritual is used to "
        },
        {
          "text": "add modifiers to spells",
          "color": "dark_purple"
        },
        {
          "text": " I have already crafted. I will first need to craft a "
        },
        {
          "text": "Book of Alteration",
          "color": "blue"
        },
        {
          "text": ", and bookmark the modifier I want to add "
        },
        {
          "text": "(use its radial menu (hold in your hand and hold 'Z') to select the modifier you want to add)",
          "italic": true
        },
        {
          "text": ". \n\nThen place the required items in the ritual and perform it to add the modifier to the spell. \n\nThis ritual will not allow me to bypass the 3 modifier limit on a spell. If I try to add more, the ritual will fail."
        }
      ]
    }
