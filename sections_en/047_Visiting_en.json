"Visiting": {
  "index": 0,
  "category": "rituals",
  "sections": [
    {
      "type": "title",
      "value": "Ritual of Visiting"
    },
    {
      "type": "text",
      "json": [
        {
          "text": "This ritual will use a "
        },
        {
          "text": "Player Charm or Rune of Marking",
          "color": "blue"
        },
        {
          "text": " to open a portal at the center of the ritual.\n\nThe portal will teleport any who step through to the location indicated by the player charm or the Rune of Marking "
        },
        {
          "text": "when the ritual was completed.  ",
          "color": "dark_purple"
        },
        {
          "text": "If the target position is in a different dimension, a "
        },
        {
          "text": "World Charm ",
          "color": "blue"
        },
        {
          "text": "must be provided for their dimension in order to find them.\n\nIf both of the optional "
        },
        {
          "text": "Bones",
          "color": "blue"
        },
        {
          "text": " are provided, the portal will instead open with a "
        },
        {
          "text": "target of the player's last death.",
          "color": "dark_purple"
        },
        {
          "text": "\n\nThis death teleport effect will be ignored if a Rune of Marking is used to target the portal."
        }
      ]
    }
  ],
  "related_recipes": [
    {
      "type": "ritual",
      "location": "mna:rituals/visit"
    },
    {
