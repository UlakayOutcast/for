"Shifting Seasons": {
  "index": 0,
  "category": "rituals",
  "sections": [
    {
      "type": "title",
      "value": "Ritual of the Shifting Seasons"
    },
    {
      "type": "text",
      "json": [
        {
          "text": "Those within the fey often feel themselves called to both summer and winter. \n\nUsing this ritual, a fey wizard can "
        },
        {
          "text": "alter which season they are currently aligned to",
          "color": "dark_purple"
        },
        {
          "text": ". \n\nThis changes their spells to cast with either "
        },
        {
          "text": "summer fire",
          "color": "red"
        },
        {
          "text": " or "
        },
        {
          "text": "winter ice",
          "color": "dark_aqua"
        },
        {
          "text": ", said spells becoming more powerful during the day or night respectively, and weaker during the opposite. \n\nThe court that is aligned to is determined by the flower chosen, with "
        },
        {
          "text": "white and pink tulips joining winter",
          "color": "dark_aqua"
        },
        {
          "text": " and "
        },
        {
          "text": "red and orange tulips joining summer.",
          "color": "red"
        }
      ]
    }
  ],
  "related_recipes": [
    {
      "type": "ritual",
      "location": "mna:rituals/shifting_seasons"
    }
  ]
}