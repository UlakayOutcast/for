      "value": "Shape: Wall"
    },
    {
      "type": "text",
      "json": [
        {
          "text": "The wall shape targets similarly to "
        },
        {
          "text": "Bolt",
          "color": "blue"
        },
        {
          "text": ", but will instead spawn a wall at the targeted point, extending out perpendicular from the direction I am facing to either side.  I can use a "
        },
        {
          "text": "Precision ",
          "color": "blue"
        },
        {
          "text": "modifier to cause the wall to horizontally align to the closest cardinal direction I am facing.\n\nThe wall will persist for the duration of the spell."
        }
      ]
    }
  ],
