"Component: Mist Form": {
  "index": "2",
  "category": "sorcery",
  "sections": [
    {
      "type": "title",
      "value": "Mist Form"
    },
    {
      "type": "text",
      "json": [
        {
          "text": "I can use the necromantic arts to "
        },
        {
          "text": "turn myself into living mist",
          "color": "dark_purple"
        },
        {
          "text": ". While I am in the form of mist, I can "
        },
        {
          "text": "fly",
          "color": "dark_purple"
        },
        {
          "text": ", "
        },
        {
          "text": "pass through any non-solid block",
          "color": "dark_purple"
        },
        {
          "text": ", and "
        },
        {
          "text": "take reduced damage",
          "color": "dark_purple"
        },
        {
          "text": " when attacked, but I "
        },
        {
          "text": "can't interact",
          "color": "dark_purple"
        },
        {
          "text": " with any block, item, or entity. "
        },
        {
          "text": "Water is dangerous",
          "color": "dark_purple"
        },
        {
          "text": " to those in mist form. \n\n"
        },
        {
          "text": "To end the effect early, double tap space as if to fly.",
          "italic": true
        },
        {
          "text": " \n\nThis spell part can only be crafted by those who have aligned themselves with the "
        },
        {
          "text": "Undead",
          "color": "dark_gray"
        },
        {
          "text": "."
        }
      ]
    }
  ],
  "related_recipes": [
    {
      "type": "spell_part",
      "location": "mna:components/mist_form"
    }
  ]
}