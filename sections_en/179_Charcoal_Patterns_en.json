"Charcoal Patterns": {
  "index": -96,
  "category": "runesmithing",
  "sections": [
    {
      "type": "title",
      "value": "Charcoal Patterns"
    },
    {
      "type": "text",
      "json": [
        {
          "text": "When I'm "
        },
        {
          "text": "Runescribing",
          "color": "blue"
        },
        {
          "text": ", I like to have a pattern handy to follow along with.  In order to get one of these patterns, "
        },
        {
          "text": "I can either trade with a Runesmith Villager, or make my own",
          "color": "dark_purple"
        },
        {
          "text": ".\n\nTo make one, I need to take a "
        },
        {
          "text": "fully forged rune",
          "color": "blue"
        },
        {
          "text": " and place it on a "
        },
        {
          "text": "Runic Anvil",
          "color": "blue"
        },
        {
          "text": ".  Atop that I need to place a piece of "
        },
        {
          "text": "paper",
          "color": "blue"
        },
        {
          "text": ".  Lastly, I need to rub the top of the paper with "
        },
        {
          "text": "coal ",
          "color": "blue"
        },
        {
          "text": "or "
        },
        {
          "text": "charcoal ",
          "color": "blue"
        },
        {
          "text": "in order to make the pattern.\n\nI can also use these patterns to help "
        },
        {
          "text": "Constructs ",
          "color": "blue"
        },
        {
          "text": "know what to scribe for me."
        }
      ]
    }
  ],
  "related_recipes": [
    {
      "type": "crafting",
      "location": "mna:runeforging/runic_anvil"
    }
  ]
}