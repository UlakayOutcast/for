  "sections": [
    {
      "type": "title",
      "value": "Bracelet of Eldrin Power"
    },
    {
      "type": "text",
      "json": [
        {
          "text": "This bracelet allows me to draw power from nearby "
        },
        {
          "text": "residual magic",
          "color": "blue"
        },
        {
          "text": " as well as "
        },
        {
          "text": "eldrin wellsprings",
          "color": "blue"
        },
        {
          "text": " if I am close enough.  I can use this to fuel my spells when I would otherwise not have enough mana. \n\n"
        },
        {
          "text": "Residual magic",
          "color": "blue"
        },
        {
          "text": " is left over in the world "
        },
        {
          "text": "whenever a spell, manaweave, or ritual is cast",
          "color": "dark_purple"
        },
        {
          "text": ".  It will slowly and harmlessly deteriorate if not used by those wearing this bracelet.\n\nThis bracelet can only be crafted by those that have aligned themselves with the "
        },
        {
          "text": "Council of Wizards",
          "color": "blue"
        },
        {
          "text": "."
        }
      ]
    }
  ],
