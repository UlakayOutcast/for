  "sections": [
    {
      "type": "title",
      "value": "Faction Horns"
    },
    {
      "type": "text",
      "json": [
        {
          "text": "I have found a recipe for a given device that resonates deeply with members of my faction. I can turn this into a horn that when blown will "
        },
        {
          "text": "summon allies from my faction to aid me",
          "color": "dark_purple"
        },
        {
          "text": ". This can only be done very infrequently, and my allies will only remain for a short duration.\n\n"
        },
        {
          "text": "You can only craft/use the horn of your faction.",
          "color": "dark_purple"
        }
      ]
    }
  ],
