      "json": [
        {
          "text": "This command will cause the construct to "
        },
        {
          "text": "harvest plants within the specified region",
          "color": "dark_purple"
        },
        {
          "text": ".\n\n"
        },
        {
          "text": "It requires a blade arm.",
          "color": "dark_purple"
        },
        {
          "text": "\n\n"
        },
        {
          "text": "Smart constructs will re-plant ageable crops where possible automatically, without needing to be instructed to do so.\n\n",
          "color": "blue"
        },
        {
          "text": "Target the plants",
          "italic": true,
          "color": "dark_purple"
        },
        {
          "text": " themselves with the Runes of Marking when setting up this task, not the dirt below them.",
          "italic": true
        }
      ]
    }
  ]
}