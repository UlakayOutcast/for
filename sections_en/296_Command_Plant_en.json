"Command: Plant": {
  "index": 4,
  "category": "constructs",
  "sections": [
    {
      "type": "title",
      "value": "Command: Plant"
    },
    {
      "type": "text",
      "json": [
        {
          "text": "This command will cause the construct to "
        },
        {
          "text": "plant the item held in its hand in farmland, grass, sand, or soul sand where appropriate",
          "color": "dark_purple"
        },
        {
          "text": " within the specified region. \n\nIt "
        },
        {
          "text": "requires a grabber arm",
          "color": "dark_purple"
        },
        {
          "text": ", and the construct must be carrying a plantable item. \nConsider using a take item command to get it into the construct's hand.\n\n"
        },
        {
          "text": "Target the soil/grass/sand/soul sand to determine where to plant,",
          "color": "dark_purple"
        },
        {
          "text": " not the air above it."
        }
      ]
    }
  ]
}