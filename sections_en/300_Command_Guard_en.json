"Command: Guard": {
  "index": 4,
  "category": "constructs",
  "sections": [
    {
      "type": "title",
      "value": "Command: Guard"
    },
    {
      "type": "text",
      "json": [
        {
          "text": "This command will cause the construct to "
        },
        {
          "text": "move to the specified point and match its facing",
          "color": "dark_purple"
        },
        {
          "text": ", standing guard and attacking enemies that come within range of its sight (if it is capable of doing so).  If its attack causes it to move too far away from the guard point (based on the construct's perception stat), "
        },
        {
          "text": "it will cease attack and return to its post",
          "color": "dark_purple"
        },
        {
          "text": ". \n\nAfter standing guard for the specified number of seconds, the task will complete and the construct will go on to any other tasks afterward."
        }
      ]
    }
  ]
}