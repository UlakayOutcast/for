"Command: Craft": {
  "index": 4,
  "category": "constructs",
  "sections": [
    {
      "type": "title",
      "value": "Command: Craft"
    },
    {
      "type": "text",
      "json": [
        {
          "text": "This command requires a "
        },
        {
          "text": "Rune of Marking",
          "color": "blue"
        },
        {
          "text": " pointed at a "
        },
        {
          "text": "Magician's Workbench",
          "color": "blue"
        },
        {
          "text": ". \n\nThe construct will move to the workbench where it will attempt to "
        },
        {
          "text": "craft the item",
          "color": "dark_purple"
        },
        {
          "text": " from the materials stored within the workbench's inventory. The "
        },
        {
          "text": "recipe used for the item will be from the Workbench's saved recipes",
          "color": "dark_purple"
        },
        {
          "text": ". \n\nThe resultant item will be placed in the construct's hand (up to as much as it can carry, with the remainder dropped on the ground)."
        },
        {
          "text": " ",
          "color": "dark_purple"
        },
        {
          "text": "\n\n"
        },
        {
          "text": "The construct needs a minimum intelligence of 16 to perform this task.",
          "color": "dark_purple"
        }
      ]
    }
  ],
  "related_recipes": [
    {
      "type": "crafting",
      "location": "mna:magicians_workbench"
    }
  ]
}