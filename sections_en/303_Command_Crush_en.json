  "sections": [
    {
      "type": "title",
      "value": "Command: Crush"
    },
    {
      "type": "text",
      "json": [
        {
          "text": "This command requires a "
        },
        {
          "text": "Rune of Marking",
          "color": "blue"
        },
        {
          "text": " pointed at a "
        },
        {
          "text": "Grindstone",
          "color": "blue"
        },
        {
          "text": ". \n\nThe construct will move to the grindstone and will attempt to look up a crushing recipe that uses the current item in the construct's hand as the recipe's input. \n\nIf found, the construct will "
        },
        {
          "text": "crush all of the items in its hand",
          "color": "dark_purple"
        },
        {
          "text": ". \n\nThe output of the crushing will be placed in the Construct's hand, with the remainder being dropped on the ground.\n\nThe construct needs a "
        },
        {
          "text": "Hammer Arm ",
          "color": "blue"
        },
        {
          "text": "in order to perform this task."
        }
      ]
    }
  ],
