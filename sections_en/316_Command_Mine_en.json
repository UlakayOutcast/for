"Command: Mine": {
  "index": 4,
  "category": "constructs",
  "sections": [
    {
      "type": "title",
      "value": "Command: Mine"
    },
    {
      "type": "text",
      "json": [
        {
          "text": "This command will cause the construct to "
        },
        {
          "text": "dig down into the earth and disappear for a few minutes on a mining journey",
          "color": "dark_purple"
        },
        {
          "text": ". When it returns it will have some random mining loot it found on its journey. \n\nIt "
        },
        {
          "text": "needs a hammer arm",
          "color": "dark_purple"
        },
        {
          "text": " to go mining, "
        },
        {
          "text": "as well as a grabber arm",
          "color": "dark_purple"
        },
        {
          "text": " at least to store items. \n\nIt will be able to bring back more items if it has a "
        },
        {
          "text": "storage torso",
          "color": "blue"
        },
        {
          "text": ". \n\n"
        },
        {
          "text": "The construct needs a minimum intelligence of 16 to perform this task.",
          "color": "dark_purple"
        }
      ]
    }
  ]
}