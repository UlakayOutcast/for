    {
      "type": "text",
      "json": [
        {
          "text": "I can apply this enchantment to weapons to help guarantee that the heads of enemies I defeat will remain intact for later use. This enchantment "
        },
        {
          "text": "increases the chance that a head will drop from a kill",
          "color": "dark_purple"
        },
        {
          "text": ". \n\n"
        },
        {
          "text": "If the loot generated already contains a head, it will not be increased more by this enchant.",
          "italic": true
        }
      ]
    }
  ],
