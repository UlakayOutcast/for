      "value": "Frost Walker"
    },
    {
      "type": "text",
      "json": [
        {
          "text": "The Frost Walker enchantment "
        },
        {
          "text": "temporarily freezes the water around you and turns it into ice",
          "color": "dark_purple"
        },
        {
          "text": ". You can then walk across the ice to quickly get around the world.\n\n"
        },
        {
          "text": "Undead",
          "color": "dark_gray"
        },
        {
          "text": " wizards using a "
        },
        {
          "text": "Staff, Wand, or Bangle",
          "color": "blue"
        },
        {
          "text": " with Frost Walker enchanted on it will gain an "
        },
        {
          "text": "aura that pulses frost damage to nearby targets",
          "color": "dark_purple"
        },
        {
          "text": ".  They will also "
        },
        {
          "text": "gain a brief instance of Mist Form when jumping while sneaking",
          "color": "dark_purple"
        },
        {
          "text": "."
        }
      ]
    }
  ],
