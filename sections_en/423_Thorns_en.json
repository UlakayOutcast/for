    {
      "type": "text",
      "json": [
        {
          "text": "The Thorns enchantment is added to your armor so that when a "
        },
        {
          "text": "player or mob physically attacks you, they will take damage",
          "color": "dark_purple"
        },
        {
          "text": " from your armor.\n\nWizards aligned with the "
        },
        {
          "text": "Fey Courts",
          "color": "dark_green"
        },
        {
          "text": " can also place Thorns onto a "
        },
        {
          "text": "Staff, Wand, or Bangle",
          "color": "blue"
        },
        {
          "text": " to cause melee attacks with that item to apply the "
        },
        {
          "text": "Writhing Brambles",
          "color": "blue"
        },
        {
          "text": " effect, which causes damage upon movement."
        }
      ]
    }
  ],
