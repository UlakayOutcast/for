          "color": "blue"
        },
        {
          "text": ", and will recharge "
        },
        {
          "text": "Constructs",
          "color": "blue"
        },
        {
          "text": " with "
        },
        {
          "text": "Mana Torsos",
          "color": "blue"
        },
        {
          "text": " within range."
