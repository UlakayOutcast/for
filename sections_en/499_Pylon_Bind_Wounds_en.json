        },
        {
          "text": " to apply an "
        },
        {
          "text": "effect that closes wounds while standing still",
          "color": "blue"
        },
        {
          "text": " to affected targets within a configurable range.\n\nThe range is either a radius centred on the pylon or can be specified by two "
        },
        {
          "text": "Runes of Marking",
          "color": "blue"
        },
        {
          "text": ". It can also be toggled to only affect factions that are allied with my own."
        }
      ]
    }
