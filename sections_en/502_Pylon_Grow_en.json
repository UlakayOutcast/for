      "value": "Pylon: Grow"
    },
    {
      "type": "text",
      "json": [
        {
          "text": "This pylon will consume large amounts of "
        },
        {
          "text": "Ender Eldrin Power",
          "color": "dark_purple"
        },
        {
          "text": " to apply an "
        },
        {
          "text": "effect that causes targets to grow in size",
          "color": "blue"
        },
        {
          "text": " within a configurable range.  Affected targets health, reach, step height, move speed, and jump height are all increased by this effect.\n\nThe range is either a radius centred on the pylon or can be specified by two "
        },
        {
          "text": "Runes of Marking",
          "color": "blue"
        },
        {
          "text": ". It can also be toggled to only affect factions that are allied with my own."
        }
      ]
    }
  ],
