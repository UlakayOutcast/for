      "value": "Pylon: Interdiction (Outbound)"
    },
    {
      "type": "text",
      "json": [
        {
          "text": "This pylon will consume small amounts of "
        },
        {
          "text": "Ender Eldrin Power",
          "color": "dark_purple"
        },
        {
          "text": " to "
        },
        {
          "text": "prevent outbound teleportation",
          "color": "blue"
        },
        {
          "text": " within a configurable range. Outbound means that the teleportation destination is outside of the configured bounds.\n\nThe range is either a radius centred on the pylon or can be specified by two "
        },
        {
          "text": "Runes of Marking",
          "color": "blue"
        },
        {
          "text": ". It can also be toggled to only affect factions that are allied with my own."
        }
      ]
    }
  ],
